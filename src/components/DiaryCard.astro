---
import { fmtDate } from '../utils';

interface Props {
  href: string;
  title: string;
  date: Date;
  datePrecision?: 'day' | 'month';
  excerpt?: string;
  index?: number;
  cover?: string | null;
  coverSmall?: boolean;
}
const { href, title, date, datePrecision = 'day', excerpt, index = 0, cover, coverSmall = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = fmtDate(date, datePrecision);
// rotate a few warm/mint tints across the placeholder media bands
const tints = ['var(--sun-peach)', 'var(--mint)', 'var(--sun-gold)', 'var(--mint-soft)'];
const tint = tints[index % tints.length];
---
<article class="card">
  <a class="card-link" href={href}>
    {cover && coverSmall ? (
      <div class="card-media card-media-small" style={`background: linear-gradient(135deg, ${tint}, var(--mint-soft));`}>
        <img src={base + cover} alt="" loading="lazy" />
      </div>
    ) : cover ? (
      <div class="card-media">
        <img src={base + cover} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
      </div>
    ) : (
      <div class="card-media" style={`background: linear-gradient(135deg, ${tint}, var(--mint-soft));`} aria-hidden="true"></div>
    )}
    <div class="card-body">
      <span class="card-date">{fmt}</span>
      <h3 class="card-title">{title}</h3>
      {excerpt && <p class="card-excerpt">{excerpt}</p>}
    </div>
  </a>
</article>
