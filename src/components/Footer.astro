---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <h4>Jolly Follies</h4>
      <p class="footer-note">A teenage Dreamweaver travel diary from the road between Land's End and Sydney, restored and rebuilt. The words are kept as they were written.</p>
    </div>
    <div>
      <h4>Explore</h4>
      <ul class="footer-links">
        <li><a href={base + '/diary/'}>The Diary</a></li>
        <li><a href={base + '/route/'}>The Route</a></li>
        <li><a href={base + '/vehicle/'}>DINO</a></li>
        <li><a href={base + '/jogle/'}>JOGLE warm-up</a></li>
        <li><a href={base + '/gallery/'}>Gallery</a></li>
      </ul>
    </div>
    <div>
      <h4>The story</h4>
      <ul class="footer-links">
        <li><a href={base + '/about/'}>About us &amp; the trip</a></li>
        <li><a href={base + '/about/#vso'}>Why VSO</a></li>
        <li><a href={base + '/contact/'}>Contact</a></li>
        <li><a href={base + '/rss.xml'}>RSS feed</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="wrap">© 2006–{year} Jolly Follies · Land's End → Sydney · Originally hand-built in Dreamweaver, rebuilt with Astro.</div>
  </div>
</footer>
