---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiaryCard from '../../components/DiaryCard.astro';
import galleries from '../../data/galleries.json';
import { getDiary, excerpt } from '../../utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const diary = await getDiary();

const coverFor = {};
for (const a of galleries.albums) {
  if (a.entry_clean && a.photos.length && !coverFor[a.entry_clean]) {
    coverFor[a.entry_clean] = a.photos[Math.floor(a.photos.length/2)].thumb;
  }
}

// group by year for a scannable timeline
const byYear = new Map<number, typeof diary>();
for (const e of diary) {
  const y = e.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(e);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const cleanSlug = (s: string) => s.replace(/^\d+-/, '');
---
<BaseLayout title="The Diary" description="Every entry from the Jolly Follies travel diary. Land's End to Sydney, written on the road.">
  <section>
    <div class="wrap">
      <div class="section-head flow">
        <p class="eyebrow">The Diary</p>
        <h1>Every entry, from the first idea to the far side of the world</h1>
        <p class="lede">{diary.length} entries, newest first. Written at the time and kept exactly as they were.</p>
      </div>

      {years.map((year) => (
        <div style="margin-top:2.5rem;">
          <h2 style="border-bottom:1px solid var(--line); padding-bottom:.4rem;">{year}</h2>
          <div class="card-grid" style="margin-top:1.4rem;">
            {byYear.get(year)!.map((e, i) => (
              <DiaryCard
                href={`${base}/diary/${cleanSlug(e.slug)}/`}
                title={e.data.title}
                date={e.data.date}
                excerpt={excerpt(e.body)}
                index={i}
                cover={coverFor[cleanSlug(e.slug)]}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
