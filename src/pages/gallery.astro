---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import galleries from '../data/galleries.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const albums = galleries.albums;
const total = albums.reduce((n, a) => n + a.count, 0);
const fmt = (d) => d ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(d)) : '';
---
<BaseLayout title="Gallery" description="Over a thousand photos from the road, Land's End to Sydney, organised by leg of the journey.">
  <section>
    <div class="wrap">
      <div class="section-head flow">
        <p class="eyebrow">Gallery</p>
        <h1>The journey, in pictures</h1>
        <p class="lede">
          {total.toLocaleString()} photos across {albums.length} legs, from the prep at home to the far side of Asia.
          Each leg is in the order it was driven. Click any photo to view it large.
        </p>
      </div>

      <nav class="leg-jump" aria-label="Jump to a leg">
        {albums.map((a) => (<a href={`#${a.slug}`}>{a.name}</a>))}
      </nav>

      {albums.map((a) => (
        <div class="leg" id={a.slug}>
          <div class="leg-head">
            <h2>{a.name}</h2>
            <p class="leg-meta">
              {fmt(a.start)}{a.end && a.end !== a.start ? ` – ${fmt(a.end)}` : ''} · {a.count} photos
              {a.entry_clean && (<> · <a href={`${base}/diary/${a.entry_clean}/`}>read the diary entry →</a></>)}
            </p>
          </div>
          <PhotoGallery photos={a.photos} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .leg-jump { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0 2.5rem; }
  .leg-jump a {
    font-family: var(--serif-display); font-size: .82rem; text-decoration: none;
    background: var(--mint-soft); border: 1px solid var(--mint-line); color: var(--navy);
    padding: .25rem .7rem; border-radius: 999px;
  }
  .leg-jump a:hover { background: var(--mint); }
  .leg { margin-top: 2.8rem; scroll-margin-top: 5rem; }
  .leg-head { border-bottom: 1px solid var(--line); padding-bottom: .5rem; margin-bottom: .5rem; }
  .leg-head h2 { margin: 0; }
  .leg-meta { margin: .3rem 0 0; color: var(--ink-soft); font-family: var(--serif-display); font-size: .9rem; }
</style>
